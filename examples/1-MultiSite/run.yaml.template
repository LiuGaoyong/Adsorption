# Shared overrides for examples/1-MultiSite.
#
# run_all.sh deep-merges this file into every <system>/<adsorbate>/run.yaml
# before running it. The per-case `sites` block already uses the GraphAtoms
# enumeration; edit this file to change the protocol or the rotamer grid for
# all multi-site examples at once.
adsorbate:
  # Rigid rotamers from the RDKit-detected rotatable bonds. Molecules with no
  # rotatable bond keep a single structure.
  conformers: rotamers
  dihedrals: 6
  max_rotamers: 64

protocol:
  n_oa: 10
  n_rot: 10
  n_d: 6
  d_min: 0.8
  d_max: 3.0
  d_min_radius_scale: 0.0
  d_max_radius_scale: 0.0
  anchor: com
  orientation_kind: auto

filters:
  - _target_: adsorption.filters.GeometryFilter
    scale: 1.0
  - _target_: adsorption.filters.LennardJonesEnergyFilter
    e_cut: null
    max_steps: 10
    fmax: 0.3
    reject_on_unconverged: false

budget:
  max_candidates: 1000000

start: 1
stop: null
outputs: ./results

parallel:
  backend: loky
  n_jobs: -1
